# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# VITE_SUPABASE_URL: Your Supabase project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Safe client-facing public anon key for authenticated and public requests
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Server-side secret service role key for admin user management (Never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# FIRST_OWNER_MASTER_KEY: Optional server secret key used to authorize initial First Owner onboarding setup
FIRST_OWNER_MASTER_KEY="tagpuan-owner-setup-key"

# GOOGLE APPS SCRIPT WEB APP API (GOOGLE SHEETS & GOOGLE DRIVE PERSISTENCE)
# VITE_GOOGLE_SCRIPT_URL: Deployed Google Apps Script Web App URL (https://script.google.com/macros/s/.../exec)
VITE_GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/AKfycbwqilwaEX_SEOo6hzUwFuMypKfbjJCla8Gv7kTVZJIOJlkBYe3y_YsHBy5UTiW-j9L6zQ/exec"

# VITE_GOOGLE_DRIVE_FOLDER_ID: Optional Google Drive Folder ID for automated PDF Sales Summaries and e-Receipts
VITE_GOOGLE_DRIVE_FOLDER_ID=""


